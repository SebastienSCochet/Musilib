<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Musilib.Desktop.ViewModels"
             xmlns:c="using:Musilib.Desktop.Controls"
             xmlns:conv="using:Musilib.Desktop.Converters"
             x:Class="Musilib.Desktop.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="260,*,Auto,Auto" Margin="0,0,0,14">
      <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" HorizontalAlignment="Stretch" />
      <Button Grid.Column="2" Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Actualiser">
        <c:LineIcon Data="{StaticResource Icon.Refresh}" Classes="small" />
      </Button>
      <Button Grid.Column="3" Classes="ghost small" Content="Effacer l'historique" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
    </Grid>

    <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsEmpty}" VerticalAlignment="Top">
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,36">
        <c:LineIcon Data="{StaticResource Icon.Clock}" Classes="huge" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Aucune activité" Classes="h3" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="card flush" Padding="6" IsVisible="{Binding !IsEmpty}">
      <ListBox Classes="rows" ItemsSource="{Binding Entries}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryLine">
            <Grid ColumnDefinitions="Auto,*,130,140" Margin="0,4">
              <Border Classes="chip small" Classes.danger="{Binding Failed}" Margin="0,0,14,0" VerticalAlignment="Top">
                <c:LineIcon Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}" Classes="small" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" Classes="small muted wrap" IsVisible="{Binding HasDetails}" />
              </StackPanel>
              <Border Grid.Column="2" Classes="badge" Classes.danger="{Binding Failed}" VerticalAlignment="Center">
                <TextBlock Text="{Binding KindText}" />
              </Border>
              <TextBlock Grid.Column="3" Text="{Binding Date}" Classes="small subtle" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
