<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Musilib.Desktop.ViewModels"
             xmlns:c="using:Musilib.Desktop.Controls"
             xmlns:app="using:Musilib.Application.Abstractions"
             xmlns:svc="using:Musilib.Application.Services"
             x:Class="Musilib.Desktop.Views.TransferView"
             x:DataType="vm:TransferViewModel">
  <Panel>
    <Border Classes="card" IsVisible="{Binding HasNoPlaylist}" VerticalAlignment="Top">
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,48">
        <c:LineIcon Data="{StaticResource Icon.Send}" Classes="huge" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Aucune playlist sélectionnée" Classes="h3" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,370" IsVisible="{Binding HasPlaylist}">
      <!-- ============ Validation globale ============ -->
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,0,16,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Validation globale" Classes="h2" />
            <TextBlock Text="Vérifiez chaque morceau et sa correspondance avant l'envoi. Seules les correspondances fiables ou confirmées peuvent être transférées." Classes="small muted wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Actualiser" VerticalAlignment="Top">
            <c:LineIcon Data="{StaticResource Icon.Refresh}" Classes="small" />
          </Button>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,14,0,10">
          <RadioButton Classes="segment" GroupName="tf" IsChecked="True" Content="Tous" Command="{Binding SetFilterCommand}" CommandParameter="all" />
          <RadioButton Classes="segment" GroupName="tf" Content="{Binding ReadyText}" Command="{Binding SetFilterCommand}" CommandParameter="ready" />
          <RadioButton Classes="segment" GroupName="tf" Content="{Binding ReviewText}" Command="{Binding SetFilterCommand}" CommandParameter="review" />
          <RadioButton Classes="segment" GroupName="tf" Content="{Binding MissingText}" Command="{Binding SetFilterCommand}" CommandParameter="missing" />
          <RadioButton Classes="segment" GroupName="tf" Content="{Binding OtherText}" Command="{Binding SetFilterCommand}" CommandParameter="other" />
        </WrapPanel>

        <Border Grid.Row="2" Classes="notice warning" Margin="0,0,0,10" IsVisible="{Binding HasReview}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:LineIcon Data="{StaticResource Icon.Alert}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Certaines correspondances sont ambiguës : elles ne seront pas envoyées tant que vous ne les aurez pas validées." Classes="small wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="outline small" Content="Valider maintenant" Command="{Binding ReviewPendingCommand}" Margin="10,0,0,0" />
          </Grid>
        </Border>

        <Border Grid.Row="3" Classes="card flush" Padding="4">
          <Grid RowDefinitions="Auto,*">
            <Grid Classes="tablehead" ColumnDefinitions="36,34,2*,2*,64,140,Auto" Margin="10,10,10,6">
              <TextBlock Text="#" Grid.Column="1" />
              <TextBlock Grid.Column="2" Text="SOURCE YOUTUBE" />
              <TextBlock Grid.Column="3" Text="CORRESPONDANCE SPOTIFY" />
              <TextBlock Grid.Column="4" Text="DURÉE" />
              <TextBlock Grid.Column="5" Text="ÉTAT" />
            </Grid>
            <ListBox Grid.Row="1" Classes="rows" ItemsSource="{Binding Rows}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferRowViewModel">
                  <Grid ColumnDefinitions="36,34,2*,2*,64,140,Auto" MinHeight="52">
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="small muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SourceTitle}" Classes="small muted" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Grid Grid.Column="3" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,10,0">
                      <c:CoverArt Source="{Binding Cover}" FallbackText="{Binding FallbackText}" Width="38" Height="38" CornerRadius="6" Margin="0,0,10,0" DecodeWidth="96" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Classes="small muted">
                          <Run Text="{Binding Artists}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Album}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="4" Text="{Binding Duration}" Classes="small muted" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="2">
                      <Border Classes="badge" Classes.success="{Binding Badge.IsSuccess}" Classes.warning="{Binding Badge.IsWarning}"
                              Classes.danger="{Binding Badge.IsDanger}" Classes.accent="{Binding Badge.IsAccent}">
                        <TextBlock Text="{Binding Badge.Text}" />
                      </Border>
                      <TextBlock Text="{Binding Note}" Classes="small subtle" />
                    </StackPanel>
                    <Button Grid.Column="6" Classes="ghost small" Content="Choisir…" Command="{Binding ChooseCommand}" ToolTip.Tip="Comparer et choisir la correspondance" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ Destination et envoi ============ -->
      <ScrollViewer Grid.Column="1" Classes="page">
        <StackPanel Spacing="14" Margin="0,0,6,0">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="Destination Spotify" Classes="h2" />
              <RadioButton GroupName="target" Content="Nouvelle playlist" IsChecked="{Binding CreateNew}" />
              <StackPanel Spacing="10" Margin="28,0,0,0" IsVisible="{Binding CreateNew}">
                <TextBox Text="{Binding NewName}" Watermark="Nom de la playlist" />
                <TextBox Text="{Binding NewDescription}" Watermark="Description (facultative)" />
                <CheckBox Content="Playlist publique" IsChecked="{Binding IsPublic}" />
              </StackPanel>
              <RadioButton GroupName="target" Content="Playlist existante" IsChecked="{Binding UseExisting}" />
              <StackPanel Spacing="10" Margin="28,0,0,0" IsVisible="{Binding UseExisting}">
                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox ItemsSource="{Binding ExistingPlaylists}" SelectedItem="{Binding SelectedExisting}" HorizontalAlignment="Stretch" PlaceholderText="Choisir…">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="app:SpotifyPlaylistInfo">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:CoverArt Source="{Binding ImageUrl}" FallbackText="{Binding Name}" Width="24" Height="24" CornerRadius="4" DecodeWidth="64" />
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="200" />
                          <TextBlock Text="{Binding TrackCount, StringFormat='· {0} titres'}" Classes="small subtle" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0" Command="{Binding LoadSpotifyPlaylistsCommand}" ToolTip.Tip="Recharger">
                    <c:LineIcon Data="{StaticResource Icon.Refresh}" Classes="small" />
                  </Button>
                </Grid>
                <CheckBox Content="Ignorer les morceaux déjà présents" IsChecked="{Binding SkipExisting}" />
                <TextBlock Text="Seules vos playlists et les playlists collaboratives sont modifiables." Classes="small subtle wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Sélection" Classes="h2" />
              <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} morceau(x) sélectionné(s)'}" Classes="muted" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost small" Content="Tous les prêts" Command="{Binding SelectAllReadyCommand}" />
                <Button Classes="ghost small" Content="Aucun" Command="{Binding SelectNoneCommand}" />
              </StackPanel>
              <TextBlock Text="L'ordre d'origine est conservé. Envoi par lots de 100 avec reprise automatique en cas d'erreur 429 ou de coupure." Classes="small subtle wrap" />
              <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding TransferCommand}" IsEnabled="{Binding CanTransfer}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:LineIcon Data="{StaticResource Icon.Send}" Classes="small" />
                  <TextBlock Text="{Binding TransferButtonText}" />
                </StackPanel>
              </Button>
              <StackPanel Spacing="6" IsVisible="{Binding HasActiveJob}">
                <ProgressBar Value="{Binding ActiveJob.Progress, FallbackValue=0}" Maximum="100" IsIndeterminate="{Binding ActiveJob.IsIndeterminate, FallbackValue=False}" />
                <TextBlock Text="{Binding ActiveJob.ProgressText, FallbackValue=''}" Classes="small muted" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="ghost small" Content="Pause" Command="{Binding ActiveJob.PauseCommand, FallbackValue={x:Null}}" />
                  <Button Classes="ghost small" Content="Annuler" Command="{Binding ActiveJob.CancelCommand, FallbackValue={x:Null}}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Résultat détaillé -->
          <Border Classes="card" IsVisible="{Binding HasReport}">
            <StackPanel Spacing="10">
              <TextBlock Text="Résultat du transfert" Classes="h2" />
              <TextBlock Text="{Binding ReportTitle}" Classes="small muted wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="outline small" Content="Ouvrir dans Spotify ↗" Command="{Binding OpenReportPlaylistCommand}" />
                <Button Classes="primary small" Content="Reprendre" Command="{Binding ResumeTransferCommand}" IsVisible="{Binding CanResumeReport}" />
              </StackPanel>
              <Expander Header="{Binding ReportAdded.Count, StringFormat='Ajoutés ({0})'}">
                <ItemsControl ItemsSource="{Binding ReportAdded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:TransferLine">
                      <TextBlock Text="{Binding Label}" Classes="small" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
              <Expander Header="{Binding ReportSkipped.Count, StringFormat='Ignorés ({0})'}">
                <ItemsControl ItemsSource="{Binding ReportSkipped}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:TransferLine">
                      <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Label}" Classes="small" />
                        <TextBlock Text="{Binding Reason}" Classes="small subtle" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
              <Expander Header="{Binding ReportFailed.Count, StringFormat='Échecs ({0})'}">
                <ItemsControl ItemsSource="{Binding ReportFailed}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:TransferLine">
                      <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Label}" Classes="small" />
                        <TextBlock Text="{Binding Reason}" Classes="small danger wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Panel>
</UserControl>
