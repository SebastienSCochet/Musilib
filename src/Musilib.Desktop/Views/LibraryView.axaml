<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Musilib.Desktop.ViewModels"
             xmlns:c="using:Musilib.Desktop.Controls"
             x:Class="Musilib.Desktop.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- Import rapide -->
    <Border Classes="card" Padding="18,14" Margin="0,0,8,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Classes="chip youtube" Margin="0,0,14,0">
          <c:LineIcon Data="{StaticResource Icon.YouTube}" />
        </Border>
        <TextBox Grid.Column="1" Text="{Binding ImportUrl}" Watermark="Coller l'URL ou l'identifiant d'une playlist YouTube (https://www.youtube.com/playlist?list=…)" />
        <CheckBox Grid.Column="2" Content="Rechercher sur Spotify ensuite" IsChecked="{Binding AutoMatch}" Margin="14,0" />
        <Button Grid.Column="3" Classes="primary" Command="{Binding ImportFromUrlCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:LineIcon Data="{StaticResource Icon.Download}" Classes="small" />
            <TextBlock Text="Importer" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <!-- ============ Playlists importées ============ -->
      <TabItem Header="Bibliothèque locale">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="320,*" Margin="0,0,8,14">
            <Panel>
              <TextBox Classes="search" Text="{Binding Filter}" Watermark="Filtrer les playlists" />
              <c:LineIcon Data="{StaticResource Icon.Search}" Classes="small" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
            </Panel>
          </Grid>
          <Border Grid.Row="1" Classes="card" IsVisible="{Binding HasNoLocal}" VerticalAlignment="Top" Margin="0,0,8,0">
            <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,40">
              <c:LineIcon Data="{StaticResource Icon.Library}" Classes="huge" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Votre bibliothèque est vide" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="Importez une playlist par URL ou depuis l'onglet « Mes playlists YouTube »." Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding HasLocal}">
            <ItemsControl ItemsSource="{Binding LocalPlaylists}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryPlaylistViewModel">
                  <Border Classes="card interactive flush" Width="258" Margin="0,0,16,16">
                    <StackPanel>
                      <Button Classes="bare" Command="{Binding OpenCommand}" CornerRadius="14,14,0,0">
                        <Panel>
                          <c:CoverArt Source="{Binding Cover}" FallbackText="{Binding Title}" Height="146" CornerRadius="13,13,0,0" DecodeWidth="480" />
                          <Border Background="#99000000" CornerRadius="999" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                            <TextBlock Text="{Binding Count}" Classes="small" Foreground="White" FontWeight="SemiBold" />
                          </Border>
                        </Panel>
                      </Button>
                      <StackPanel Margin="16,14,16,14" Spacing="8">
                        <TextBlock Text="{Binding Title}" Classes="h3" />
                        <TextBlock Text="{Binding Synced}" Classes="small subtle" />
                        <c:MeterBar Fill="{DynamicResource AccentBrush}" Value="{Binding MatchedPercent}" Maximum="100" Margin="0,4,0,0" Track="{DynamicResource SurfaceHoverBrush}" />
                        <WrapPanel>
                          <Border Classes="badge accent" Margin="0,0,6,6"><TextBlock Text="{Binding MatchedText}" /></Border>
                          <Border Classes="badge warning" Margin="0,0,6,6" IsVisible="{Binding HasReview}"><TextBlock Text="{Binding ReviewText}" /></Border>
                          <Border Classes="badge danger" Margin="0,0,6,6" IsVisible="{Binding HasMissing}"><TextBlock Text="{Binding MissingText}" /></Border>
                          <Border Classes="badge info" Margin="0,0,6,6" IsVisible="{Binding HasPending}"><TextBlock Text="{Binding PendingText}" /></Border>
                        </WrapPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <Button Classes="outline small" Content="Ouvrir" Command="{Binding OpenCommand}" />
                          <Button Grid.Column="1" Classes="icon" Command="{Binding SyncCommand}" ToolTip.Tip="Resynchroniser avec YouTube">
                            <c:LineIcon Data="{StaticResource Icon.Refresh}" Classes="small" />
                          </Button>
                          <Button Grid.Column="2" Classes="icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Supprimer de Musilib">
                            <c:LineIcon Data="{StaticResource Icon.Trash}" Classes="small" />
                          </Button>
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ============ Playlists YouTube ============ -->
      <TabItem Header="Mes playlists YouTube">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,8,14">
            <TextBlock Text="Playlists accessibles avec votre compte YouTube (y compris privées et « J'aime »)." Classes="muted" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="outline" Command="{Binding LoadRemoteCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:LineIcon Data="{StaticResource Icon.Refresh}" Classes="small" />
                <TextBlock Text="Actualiser" />
              </StackPanel>
            </Button>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="12">
            <ProgressBar IsIndeterminate="True" Classes="thin" IsVisible="{Binding RemoteLoading}" />
            <Border Classes="notice warning" IsVisible="{Binding HasRemoteError}">
              <TextBlock Text="{Binding RemoteError}" Classes="small wrap" />
            </Border>
          </StackPanel>
          <ScrollViewer Grid.Row="1" Classes="page" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding RemotePlaylists}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RemotePlaylistViewModel">
                  <Border Classes="card interactive tight" Width="390" Margin="0,0,14,14">
                    <Grid ColumnDefinitions="Auto,*">
                      <c:CoverArt Source="{Binding Cover}" FallbackText="{Binding Title}" Width="96" Height="72" CornerRadius="8" Margin="0,0,14,0" />
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding Title}" Classes="h3" />
                        <TextBlock Text="{Binding Count}" Classes="small muted" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                          <Button Classes="primary small" Command="{Binding ImportCommand}" IsVisible="{Binding !IsImported}">
                            <TextBlock Text="{Binding ImportLabel}" />
                          </Button>
                          <Button Classes="outline small" Command="{Binding ImportCommand}" IsVisible="{Binding IsImported}">
                            <TextBlock Text="{Binding ImportLabel}" />
                          </Button>
                          <Border Classes="badge success" IsVisible="{Binding IsImported}"><TextBlock Text="Importée" /></Border>
                          <Border Classes="badge info" IsVisible="{Binding IsQueued}"><TextBlock Text="En file" /></Border>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
