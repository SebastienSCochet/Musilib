{
  "// NOTE": "Fichier de configuration SANS SECRET. Les identifiants clients se saisissent dans l'écran Connexions ; le client secret Google, la clé API et les jetons sont chiffrés (DPAPI). Les paramètres modifiés dans l'application sont enregistrés dans %APPDATA%\\Musilib\\settings.json. Toute valeur peut être surchargée par variable d'environnement : MUSILIB_Musilib__Spotify__ClientId=...",
  "Musilib": {
    "General": {
      "DemoMode": false,
      "Theme": "Dark"
    },
    "YouTube": {
      "ClientId": "",
      "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "TokenEndpoint": "https://oauth2.googleapis.com/token",
      "RevocationEndpoint": "https://oauth2.googleapis.com/revoke",
      "ApiBaseUrl": "https://www.googleapis.com/youtube/v3/",
      "Scope": "https://www.googleapis.com/auth/youtube.readonly"
    },
    "Spotify": {
      "ClientId": "",
      "RedirectPort": 5543,
      "AuthorizationEndpoint": "https://accounts.spotify.com/authorize",
      "TokenEndpoint": "https://accounts.spotify.com/api/token",
      "ApiBaseUrl": "https://api.spotify.com/v1/",
      "Scope": "playlist-read-private playlist-read-collaborative playlist-modify-private playlist-modify-public",
      "Market": "from_token"
    },
    "Processing": {
      "MaxConcurrentJobs": 2,
      "MaxConcurrentRequests": 4,
      "MaxRetries": 5,
      "MaxRetryAfterSeconds": 120,
      "AutoResumeJobs": true,
      "SearchCacheDays": 30
    },
    "Matching": {
      "AutoAcceptThreshold": 0.85,
      "MinimumThreshold": 0.5,
      "AmbiguityGap": 0.07,
      "SearchLimit": 10,
      "ApplySpotifyMetadata": true
    },
    "Export": {
      "DefaultFolder": "",
      "Organization": "ArtistAlbum",
      "ConflictResolution": "Skip",
      "WriteTags": true,
      "EmbedCover": true,
      "WriteM3u": true,
      "FfmpegPath": "",
      "ConvertTo": "",
      "BitrateKbps": 320
    }
  }
}
